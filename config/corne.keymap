#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        ctrl_alt_del: ctrl_alt_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LEFT_CONTROL &kp LEFT_ALT &kp DEL>;

            label = "CTRL_ALT_DEL";
        };
    };

    combos { compatible = "zmk,combos"; };

    //

    keymap {
        compatible = "zmk,keymap";

        Defualt {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp ESCAPE    &kp Q  &kp W  &kp E           &kp R  &kp T        &kp Y    &kp U  &kp I              &kp O    &kp P     &kp BACKSPACE
&kp TAB       &kp A  &kp S  &kp D           &kp F  &kp G        &kp H    &kp J  &kp K              &kp L    &kp SEMI  &kp DELETE
&kp LEFT_GUI  &kp Z  &kp X  &kp C           &kp V  &kp B        &kp N    &kp M  &kp COMMA          &kp DOT  &kp FSLH  &kp RIGHT_ALT
                            &kp LEFT_SHIFT  &mo 2  &kp SPACE    &kp RET  &mo 1  &kp RIGHT_CONTROL
            >;
        };

        Symbols {
            display-name = "Sym";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp GRAVE  &kp SLASH      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp APOSTROPHE    &kp PLUS         &kp NUMBER_7  &kp NUMBER_8  &kp KP_NUMBER_9  &none       &trans
&trans  &kp TILDE  &kp PIPE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL         &kp MINUS        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6     &kp COMMA   &trans
&trans  &none      &kp BACKSLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp UNDERSCORE    &kp KP_NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp PERIOD  &trans
                                  &trans                &mo 3                  &kp SPACE         &kp RET          &trans        &trans
            >;
        };

        Navigation {
            display-name = "Nav";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&none  &none  &none  &none  &none  &none        &kp HOME        &kp PG_DN       &kp PG_UP     &kp END          &kp F11  &kp F12
&none  &none  &none  &none  &none  &none        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none    &none
&none  &none  &none  &none  &none  &none        &none           &none           &none         &none            &none    &none
                     &none  &none  &kp SPACE    &kp RET         &mo 3           &none
            >;
        };

        Device {
            display-name = "Dev";
            bindings = <
&trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE        &kp C_PAUSE     &kp C_PREVIOUS  &kp C_NEXT  &kp F20  &trans       &ctrl_alt_del
&trans  &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4      &studio_unlock  &bt BT_NXT      &bt BT_PRV  &trans   &trans       &trans
&trans  &trans                &trans                &trans             &bt BT_CLR       &bt BT_CLR_ALL    &trans          &trans          &trans      &trans   &bootloader  &trans
                                                    &trans             &trans           &trans            &trans          &trans          &trans
            >;
        };
    };
};
