#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <13 29>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <12 38>;
        };

        lp {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
        };

        rp {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <28 27>;
        };

        lb {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 17>;
        };

        rb {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <28 29>;
        };

        ls {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <14 15>;
        };

        rs {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <27 26>;
        };

        lt {
            bindings = <&kp LESS_THAN>;
            key-positions = <13 14>;
        };

        gt {
            bindings = <&kp GREATER_THAN>;
            key-positions = <25 26>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I              &kp O    &kp P     &kp BACKSPACE
&kp LEFT_SHIFT    &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K              &kp L    &kp SEMI  &kp RETURN
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA          &kp DOT  &kp FSLH  &kp RIGHT_ALT
                                &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RIGHT_CONTROL
            >;
        };

        NAV {
            display-name = "NavNum";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp F1      &kp F2         &kp F3          &kp F4        &kp F5          &kp F6             &kp F7          &kp F8          &kp F9        &kp F10          &kp F11   &kp F12
&caps_word  &kp PAGE_UP    &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp HOME  &trans
&trans      &kp PAGE_DOWN  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans          &mkp LCLK       &mkp MCLK     &mkp RCLK        &kp END   &trans
                                           &kp LGUI      &trans          &kp SPACE          &kp RET         &mo 3           &trans
            >;
        };

        SYM {
            display-name = "Symbols";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp GRAVE          &kp TILDE         &kp SLASH          &kp PIPE               &kp BACKSLASH      &kp PLUS         &kp NUMBER_7  &kp NUMBER_8  &kp KP_NUMBER_9  &kp EQUAL   &trans
&trans  &kp APOSTROPHE     &kp LESS_THAN     &kp LEFT_BRACKET   &kp LEFT_PARENTHESIS   &kp LEFT_BRACE     &kp MINUS        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6     &kp COMMA   &trans
&trans  &kp DOUBLE_QUOTES  &kp GREATER_THAN  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE    &kp KP_NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp PERIOD  &trans
                                             &kp LGUI           &mo 3                  &kp SPACE          &kp RET          &trans        &trans
            >;
        };

        ADJ {
            display-name = "Dev";
            bindings = <
&trans  &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC    &kp F20         &kp PRINTSCREEN  &kp F8      &kp F9  &kp F10      &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3          &bt BT_SEL 4            &studio_unlock  &bt BT_NXT       &bt BT_PRV  &trans  &trans       &trans
&trans  &trans        &trans             &trans           &bt BT_CLR            &bt BT_CLR_ALL          &trans          &trans           &trans      &trans  &bootloader  &trans
                                         &trans           &trans                &trans                  &trans          &trans           &trans
            >;
        };
    };
};
